# Copiar a backend/.env (ignorado). Sin estas variables, desarrollo usa SQLite.
DJANGO_DEBUG=true
# Online: DJANGO_CSRF_TRUSTED_ORIGINS=https://apl-seguridad.vercel.app
# Online: false, clave aleatoria larga, hosts y origen HTTPS exactos, PostgreSQL obligatorio.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Usar la URI Session pooler de Connect en Supabase. Codificar contraseña en la URI.
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
